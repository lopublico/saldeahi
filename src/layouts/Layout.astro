---
import { datasetDe } from '@lopublico/ui/seo.js';
import "../styles/global.css";
import "@/styles/sd-app.css";
import BaseLayout from "@lopublico/ui/Layout.astro";

const {
  title       = "Sal de ahí",
  description = "Los gobiernos democráticos siguen habitando espacios gobernados por oligarcas.",
  image       = "/og-image.png",
  landing     = false,
} = Astro.props;

const siteBase  = Astro.site?.toString().replace(/\/$/, '') ?? 'https://saldeahi.lopublico.es';
const canonical = new URL(Astro.url.pathname, siteBase).toString();
// La cabecera la pone cada página (Topbar), porque va sobre el hero oscuro
const ogImage   = image.startsWith('http') ? image : `${siteBase}${image}`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName="Sal de ahí - Lo Público"
  twitterUrl
  imagenes={[
    { url: ogImage, width: 1200, height: 630, tipo: "image/png", alt: title, secure: true },
    { url: `${siteBase}/og-image-square.jpg`, width: 1024, height: 1024, tipo: "image/jpeg", alt: title, secure: true },
  ]}
  dataset={Astro.url.pathname === '/' ? datasetDe('sal-de-ahi', { descripcion: description, url: canonical }) : undefined}
  faviconTipo="image/png"
  landing={landing}
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
  htmlAttrs={{ class: "h-full antialiased", prefix: "og: https://ogp.me/ns#" }}
  bodyClass="min-h-svh overflow-x-clip grid grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto] bg-background text-foreground"
  mainClass="relative pb-16"
  pie={{ enlaces: [{ href: "/datos", texto: "Datos" }] }}
  reporte={{
    proyecto: "sal-de-ahi",
    endpoint: import.meta.env.PUBLIC_REPORT_ENDPOINT || "https://lopublico-reportes.report-erratum.workers.dev",
    sitekey: import.meta.env.PUBLIC_TURNSTILE_SITEKEY || "0x4AAAAAAFJ4NSzh_dBY0vQ5",
    titulo: "Reportar dato incorrecto",
    subtitulo: "Lo revisaremos y actualizaremos los datos si procede",
    pideFuente: false,
    categorias: [
      { value: "twitter", label: "X / Twitter", pideValor: true, placeholder: "@handle" },
      { value: "bluesky", label: "Bluesky", pideValor: true, placeholder: "handle.bsky.social" },
      { value: "mastodon", label: "Mastodon", pideValor: true, placeholder: "https://mastodon.social/@handle" },
      { value: "suspendida", label: "La cuenta está suspendida o no existe" },
      { value: "falta", label: "Falta una cuenta que no aparece" },
      { value: "otro", label: "Otro" },
    ],
  }}
>
  <slot />
</BaseLayout>
