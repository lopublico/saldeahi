<script>
  import "@lopublico/ui/sort-table.js";
  // La Datos/Metodología guarda su estado en el hash (#metodologia) para poder enlazarla
  function initVista() {
    const cont = document.querySelector<HTMLElement>('[data-lp-grupo="vista"]');
    if (!cont) return;
    const quiere = location.hash === '#metodologia' ? 'metodologia' : 'datos';
    cont.querySelector<HTMLButtonElement>(`[data-value="${quiere}"]`)?.click();
    if (!cont.dataset.hashListo) {
      cont.dataset.hashListo = '1';
      cont.addEventListener('lp:tab', (e) => {
        const v = (e as CustomEvent).detail.value;
        history.replaceState(null, '', v === 'datos' ? location.pathname : `#${v}`);
      });
    }
  }
  document.addEventListener('astro:page-load', initVista);
  initVista();

  function initBarWidths() {
    document.querySelectorAll<HTMLElement>('[data-left]').forEach(el => {
      el.style.left = el.dataset.left + '%';
    });
  }
  document.addEventListener('astro:page-load', initBarWidths);
  initBarWidths();

</script>
