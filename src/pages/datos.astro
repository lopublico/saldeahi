          <!-- Mastodon -->
          <div class="datos-plat-card datos-plat-card--mstdn">
            <div class="datos-plat-header">
              <span class="datos-plat-badge datos-plat-badge--mstdn">Mastodon</span>
              <span class="datos-plat-nature">ActivityPub W3C</span>
            </div>
            <div class="datos-plat-kpi">
              <Donut sectores={[{ etiqueta: "", valor: Math.max(pctActMstdnOfTotal ?? 0, totales.activoMstdn > 0 ? 1 : 0), color: "var(--sd-mastodon)" }]} maximo={100} tam={40} grosor={4} leyenda={false} decorativo />
              <div class="datos-plat-num text-violet-700">{totales.activoMstdn}</div>
              <div class="datos-plat-pct text-violet-700">{pctActMstdnOfTotal}% activas</div>
            </div>
            <div class="datos-plat-bar-wrap">
              <Barra alto="md" tramos={[{ pct: pctActMstdnOfTotal, color: "var(--sd-mastodon)" }, { pct: pctMstdn - pctActMstdnOfTotal, color: "var(--sd-mastodon-soft)" }]} />
              <div class="datos-plat-bar-labels">
                <span>{pctActMstdnOfTotal}% activas</span>
                <span>{pctMstdn}% con cuenta ({totales.conMastodon})</span>
              </div>
            </div>
            <div class="datos-plat-stats">
              <div class="datos-plat-stat-row">
                <span>Con cuenta sin actividad reciente</span>
