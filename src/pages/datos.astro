          columnas={[{ titulo: "X / Twitter", color: "var(--sd-fg-2)" }, { titulo: "Bluesky", color: "var(--sd-sky)" }, { titulo: "Mastodon", color: "var(--sd-mastodon)" }]}
          filas={catStats.map((c) => ({
            etiqueta: c.label,
