            Inactivas o sin cuenta en X, con presencia activa en Bluesky o Mastodon.
          </p>
        </div>
      </div>
    </Panel>

    <!-- ── Distribución por plataforma ────────────────────────────────────── -->
    <Panel titulo="Distribución por plataforma" subtitulo={`Proporción sobre las ${totalesBase} entidades con presencia en alguna red social (se excluyen las ${totales.sinNinguna} sin ninguna cuenta).`}>

      <!-- Barras comparativas -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 mb-8">
        <BarraProporcion etiqueta="X / Twitter" cifras={`${totales.conTwitter} con cuenta (${pctFmt(totales.conTwitter, totalesBase)}) · ${totales.enX} activas (${pctEnX}%)`} tramos={[{ pct: pctEnX, color: "var(--sd-fg-2)", opacidad: 0.75 }, { pct: pctConTw - pctEnX, color: "var(--sd-fg-2)", opacidad: 0.2 }]} />
        <BarraProporcion etiqueta="Bluesky" cifras={`${totales.conBluesky} con cuenta (${pctFmt(totales.conBluesky, totalesBase)}) · ${totales.activoBsky} activas (${pctActBskyOfTotal}%)`} tramos={[{ pct: pctActBskyOfTotal, color: "var(--sd-sky)" }, { pct: pctBsky - pctActBskyOfTotal, color: "var(--sd-sky-soft)" }]} />
        <BarraProporcion etiqueta="Mastodon" cifras={`${totales.conMastodon} con cuenta (${pctFmt(totales.conMastodon, totalesBase)}) · ${totales.activoMstdn} activas (${pctActMstdnOfTotal}%)`} tramos={[{ pct: pctActMstdnOfTotal, color: "var(--sd-mastodon)" }, { pct: pctMstdn - pctActMstdnOfTotal, color: "var(--sd-mastodon-soft)" }]} />
        <BarraProporcion etiqueta="Sin alternativa a X" nota="(sin Bluesky ni Mastodon)" cifras={`${totales.sinAlternativa} (${pctFmt(totales.sinAlternativa, totalesBase)})`} tramos={[{ pct: pctNingW, color: "var(--sd-rose-pink)", opacidad: 0.7 }]} alerta />
      </div>

      <!-- Leyenda -->
      <div class="dist-legend mb-6">
        <span class="dist-legend-item">
          <span class="dist-legend-swatches">
            <span class="dist-legend-swatch dist-legend-swatch--x-act"></span>
            <span class="dist-legend-swatch dist-legend-swatch--bsky-act"></span>
            <span class="dist-legend-swatch dist-legend-swatch--mstdn-act"></span>
          </span>
          Activas (publicación en los últimos 30 días)
        </span>
        <span class="dist-legend-item">
          <span class="dist-legend-swatches">
            <span class="dist-legend-swatch dist-legend-swatch--x-inact"></span>
            <span class="dist-legend-swatch dist-legend-swatch--bsky-inact"></span>
            <span class="dist-legend-swatch dist-legend-swatch--mstdn-inact"></span>
          </span>
          Con cuenta, sin actividad reciente
        </span>
        <span class="dist-legend-item">
          <span class="dist-legend-swatch dist-legend-swatch--sin-alt"></span>
          Sin alternativa a X
        </span>
      </div>

      <p class="datos-proto-note">
        <strong>Nota:</strong> Bluesky (AT Protocol) y Mastodon (ActivityPub) son protocolos distintos con diferente nivel de apertura. ActivityPub es un estándar formal del W3C; AT Protocol está controlado por Bluesky Social PBC. <a href="/porque">Más información</a>.
      </p>
    </Panel>

