---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { ExportButton } from "@/components/ExportButton";
import lastUpdateData from "@/data/lastUpdate.json";
import ageData from "@/data/age.json";
import gobiernoData from "@/data/gobierno.json";
import congresoData from "@/data/congreso.json";
import senadoData from "@/data/senado.json";
import partidosData from "@/data/partidos.json";
import autonomiasData from "@/data/autonomias.json";
import universidadesData from "@/data/universidades.json";

const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
const lastUpdate = lastUpdateData as any;

function platformRef(d: string | undefined) {
  return d ? new Date(d + "T00:00:00Z").getTime() : Date.now();
}
const TWITTER_REF  = platformRef(lastUpdate.twitter);
const BLUESKY_REF  = platformRef(lastUpdate.bluesky);
const MASTODON_REF = platformRef(lastUpdate.mastodon);

function isActiveDate(val: unknown, ref: number): boolean {
  if (!val || typeof val !== "string") return false;
  if (!/^\d{4}-\d{2}-\d{2}/.test(val)) return false;
  return ref - new Date(val).getTime() <= THIRTY_DAYS_MS;
}
function twitterOnX(handle: unknown, activo: unknown): boolean {
  if (!handle) return false;
  if (activo == null) return false;
  return isActiveDate(activo, TWITTER_REF);
}
function normalizeItem(item: any) {
  const tw = String(item.twitter_activo ?? "").startsWith("404") ? null : (item.twitter || null);
  return {
    twitter:         tw,
    twitter_activo:  twitterOnX(tw, item.twitter_activo),
    bluesky:         item.bluesky  || null,
    bluesky_activo:  isActiveDate(item.bluesky_activo, BLUESKY_REF),
    mastodon:        item.mastodon || null,
    mastodon_activo: isActiveDate(item.mastodon_activo, MASTODON_REF),
    grupo:           item.grupo || null,
    tipo:            item.tipo || null,
  };
}

const CATEGORIES = [
  { key: "age",           label: "Administración",  data: ageData           },
  { key: "gobierno",      label: "Gobierno",         data: gobiernoData      },
  { key: "congreso",      label: "Congreso",         data: congresoData      },
  { key: "senado",        label: "Senado",           data: senadoData        },
  { key: "partidos",      label: "Partidos",         data: partidosData      },
  { key: "autonomias",    label: "Autonomías",       data: autonomiasData    },
  { key: "universidades", label: "Universidades",    data: universidadesData },
];

const catStats = CATEGORIES.map(({ key, label, data }) => {
  const items = (data as any[]).map(normalizeItem);
  const total          = items.length;
  const conTwitter     = items.filter(x => x.twitter).length;
  const enX            = items.filter(x => x.twitter_activo).length;
  const sinActX        = conTwitter - enX;
  const conBluesky     = items.filter(x => x.bluesky).length;
  const activoBsky     = items.filter(x => x.bluesky_activo).length;
  const conMastodon    = items.filter(x => x.mastodon).length;
  const activoMstdn    = items.filter(x => x.mastodon_activo).length;
  const sinAlternativa = items.filter(x => !x.bluesky && !x.mastodon).length;
  const sinNinguna     = items.filter(x => !x.twitter && !x.bluesky && !x.mastodon).length;
  const pctFuera       = total > 0 ? Math.round(((total - enX) / total) * 100) : 0;
  const pctBsky        = total > 0 ? Math.round((conBluesky / total) * 100) : 0;
  return { key, label, total, conTwitter, enX, sinActX, conBluesky, activoBsky, conMastodon, activoMstdn, sinAlternativa, sinNinguna, pctFuera, pctBsky };
});

const totales = catStats.reduce(
  (acc, c) => ({
    total:          acc.total          + c.total,
    conTwitter:     acc.conTwitter     + c.conTwitter,
    enX:            acc.enX            + c.enX,
    sinActX:        acc.sinActX        + c.sinActX,
    conBluesky:     acc.conBluesky     + c.conBluesky,
    activoBsky:     acc.activoBsky     + c.activoBsky,
    conMastodon:    acc.conMastodon    + c.conMastodon,
    activoMstdn:    acc.activoMstdn    + c.activoMstdn,
    sinAlternativa: acc.sinAlternativa + c.sinAlternativa,
    sinNinguna:     acc.sinNinguna     + c.sinNinguna,
  }),
  { total: 0, conTwitter: 0, enX: 0, sinActX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, activoMstdn: 0, sinAlternativa: 0, sinNinguna: 0 }
);

const conAlternativa    = totales.total - totales.sinAlternativa;

const allNormalizedItems = CATEGORIES.flatMap(({ data }) => (data as any[]).map(normalizeItem));
const sustFuncionalTotal = allNormalizedItems.filter(x => !x.twitter_activo && (x.bluesky_activo || x.mastodon_activo)).length;

function pctVal(num: number, den: number) {
  return den > 0 ? Math.round((num / den) * 100) : 0;
}
function pctFmt(num: number, den: number) {
  const v = pctVal(num, den);
  return v === 0 && num > 0 ? "~0%" : `${v}%`;
}
function pctNum(num: number, den: number) {
  const v = pctVal(num, den);
  return v === 0 && num > 0 ? "~0" : `${v}`;
}

const pctFueraDeX       = pctVal(totales.total - totales.enX, totales.total);
const pctEnX            = pctVal(totales.enX,        totales.total);
const pctConTw          = pctVal(totales.conTwitter, totales.total);
const pctBsky           = pctVal(totales.conBluesky, totales.total);
const pctActivoBsky     = pctVal(totales.activoBsky, totales.conBluesky);
const pctMstdn          = pctVal(totales.conMastodon, totales.total);
const pctActivoMstdn    = pctVal(totales.activoMstdn, totales.conMastodon);
const pctSinNinguna     = pctVal(totales.sinNinguna,  totales.total);
const pctNingW          = pctVal(totales.sinAlternativa, totales.total);
const pctSinActX        = pctVal(totales.sinActX,     totales.total);
const pctActBskyOfTotal = pctVal(totales.activoBsky,  totales.total);
const pctActMstdnOfTotal= pctVal(totales.activoMstdn, totales.total);
const pctSustFunc       = pctVal(sustFuncionalTotal,  totales.total);

// ── Stats de error 404 en Twitter (para metodología) ─────────────────────────
const allItems = CATEGORIES.flatMap(({ data }) => data as any[]);
const tw404Count = allItems.filter(r => r.twitter && String(r.twitter_activo ?? "").startsWith("404")).length;
const twTotal    = allItems.filter(r => r.twitter).length;
const tw404Pct   = twTotal > 0 ? (tw404Count / twTotal * 100).toFixed(1) : "0";
const twRefMes   = lastUpdate.twitter
  ? new Date(lastUpdate.twitter + "T00:00:00Z").toLocaleDateString("es-ES", { month: "long", year: "numeric", timeZone: "UTC" })
  : "";

// ── Congreso: por grupo parlamentario (solo diputados) ────────────────────────
const CONGRESO_GRUPO_LABELS: Record<string, string> = {
  "Grupo Parlamentario Popular en el Congreso":   "PP",
  "Grupo Parlamentario Socialista":               "PSOE",
  "Grupo Parlamentario VOX":                      "VOX",
  "Grupo Parlamentario Plurinacional SUMAR":      "SUMAR",
  "Grupo Parlamentario Mixto":                    "Mixto",
  "Grupo Parlamentario Junts per Catalunya":      "Junts",
  "Grupo Parlamentario Republicano":              "ERC",
  "Grupo Parlamentario Euskal Herria Bildu":      "EH Bildu",
  "Grupo Parlamentario Vasco (EAJ-PNV)":          "PNV",
};

type GrupoStat = { total: number; enX: number; fueraDeX: number; conBluesky: number; activoBsky: number; conMastodon: number; sinAlternativa: number };

const congresoGruposMap: Record<string, GrupoStat> = {};

for (const raw of congresoData as any[]) {
  if (raw.tipo !== "Diputado/a" || !raw.grupo) continue;
  const label = CONGRESO_GRUPO_LABELS[raw.grupo] ?? raw.grupo;
  if (!congresoGruposMap[label]) congresoGruposMap[label] = { total: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0 };
  const g = congresoGruposMap[label];
  const item = normalizeItem(raw);
  g.total++;
  if (item.twitter_activo) g.enX++; else g.fueraDeX++;
  if (item.bluesky)        g.conBluesky++;
  if (item.bluesky_activo) g.activoBsky++;
  if (item.mastodon)       g.conMastodon++;
  if (!item.bluesky && !item.mastodon) g.sinAlternativa++;
}

const CONGRESO_GRUPO_ORDER = ["PP", "PSOE", "VOX", "SUMAR", "ERC", "EH Bildu", "Junts", "PNV", "Mixto"];
const gruposStats = CONGRESO_GRUPO_ORDER
  .filter(k => congresoGruposMap[k])
  .map(k => {
    const g = congresoGruposMap[k];
    return {
      label: k, ...g,
      pctFuera:  Math.round((g.fueraDeX       / g.total) * 100),
      pctBsky:   Math.round((g.conBluesky      / g.total) * 100),
      pctEnX:    Math.round((g.enX             / g.total) * 100),
      pctBskyA:  Math.round((g.activoBsky      / g.total) * 100),
      pctMstdn:  Math.round((g.conMastodon     / g.total) * 100),
      pctSinAlt: Math.round((g.sinAlternativa  / g.total) * 100),
    };
  });

const congresoTotales = gruposStats.reduce(
  (acc, g) => ({ total: acc.total + g.total, enX: acc.enX + g.enX, fueraDeX: acc.fueraDeX + g.fueraDeX, conBluesky: acc.conBluesky + g.conBluesky, activoBsky: acc.activoBsky + g.activoBsky, conMastodon: acc.conMastodon + g.conMastodon, sinAlternativa: acc.sinAlternativa + g.sinAlternativa }),
  { total: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0 }
);

// ── Senado: por grupo parlamentario ───────────────────────────────────────────
const SENADO_GRUPO_LABELS: Record<string, string> = {
  "GPP":   "PP",
  "GPS":   "PSOE",
  "GPERB": "ERC / EH Bildu",
  "GPIC":  "Izq. Confederal",
  "GPPLU": "Plural",
  "GPV":   "PNV",
  "GPMX":  "Mixto",
};

const CONGRESO_GRUPO_FULLNAMES: Record<string, string> = {
  "PP":       "Partido Popular",
  "PSOE":     "Partido Socialista Obrero Español",
  "VOX":      "VOX",
  "SUMAR":    "Sumar",
  "ERC":      "Esquerra Republicana de Catalunya",
  "EH Bildu": "Euskal Herria Bildu",
  "Junts":    "Junts per Catalunya",
  "PNV":      "EAJ-PNV",
  "Mixto":    "Grupo Parlamentario Mixto",
};

const SENADO_GRUPO_FULLNAMES: Record<string, string> = {
  "PP":              "Partido Popular",
  "PSOE":            "Partido Socialista Obrero Español",
  "ERC / EH Bildu":  "Izquierdas por la Independencia (ERC + EH Bildu)",
  "Izq. Confederal": "Izquierda Confederal (Más Madrid, Compromís, ASG, Geroa Bai…)",
  "Plural":          "Grupo Plural (Junts, Coalición Canaria, BNG, AHI)",
  "PNV":             "Euzko Alderdi Jeltzalea – Partido Nacionalista Vasco",
  "Mixto":           "Grupo Parlamentario Mixto",
};

const senadoGruposMap: Record<string, GrupoStat> = {};

for (const raw of senadoData as any[]) {
  if (raw.tipo !== "Senador/a" || !raw.grupo) continue;
  const label = SENADO_GRUPO_LABELS[raw.grupo] ?? raw.grupo;
  if (!senadoGruposMap[label]) senadoGruposMap[label] = { total: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0 };
  const g = senadoGruposMap[label];
  const item = normalizeItem(raw);
  g.total++;
  if (item.twitter_activo) g.enX++; else g.fueraDeX++;
  if (item.bluesky)        g.conBluesky++;
  if (item.bluesky_activo) g.activoBsky++;
  if (item.mastodon)       g.conMastodon++;
  if (!item.bluesky && !item.mastodon) g.sinAlternativa++;
}

const SENADO_GRUPO_ORDER = ["PP", "PSOE", "ERC / EH Bildu", "Izq. Confederal", "Plural", "PNV", "Mixto"];
const senadoGruposStats = SENADO_GRUPO_ORDER
  .filter(k => senadoGruposMap[k])
  .map(k => {
    const g = senadoGruposMap[k];
    return {
      label: k, ...g,
      pctFuera:  Math.round((g.fueraDeX       / g.total) * 100),
      pctBsky:   Math.round((g.conBluesky      / g.total) * 100),
      pctEnX:    Math.round((g.enX             / g.total) * 100),
      pctBskyA:  Math.round((g.activoBsky      / g.total) * 100),
      pctMstdn:  Math.round((g.conMastodon     / g.total) * 100),
      pctSinAlt: Math.round((g.sinAlternativa  / g.total) * 100),
    };
  });

const senadoTotales = senadoGruposStats.reduce(
  (acc, g) => ({ total: acc.total + g.total, enX: acc.enX + g.enX, fueraDeX: acc.fueraDeX + g.fueraDeX, conBluesky: acc.conBluesky + g.conBluesky, activoBsky: acc.activoBsky + g.activoBsky, conMastodon: acc.conMastodon + g.conMastodon, sinAlternativa: acc.sinAlternativa + g.sinAlternativa }),
  { total: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0 }
);

// ── Gradiente ideológico (orden izq→der) ──────────────────────────────────────
const GRADIENTE_ORDER = ["SUMAR", "EH Bildu", "ERC", "Mixto", "PSOE", "Junts", "PNV", "VOX", "PP"];
const gruposGradiente = GRADIENTE_ORDER
  .map(k => gruposStats.find(g => g.label === k))
  .filter((g): g is NonNullable<typeof g> => g != null);
const bskyMaxGrupo = gruposStats.reduce((a, b) => a.pctBsky >= b.pctBsky ? a : b, gruposStats[0]);
const bskyMinGrupo = gruposStats.reduce((a, b) => a.pctBsky <= b.pctBsky ? a : b, gruposStats[0]);

function fmtDate(d: string | undefined) {
  if (!d) return "—";
  return new Date(d + "T00:00:00Z").toLocaleDateString("es-ES", {
    day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}

// ── Helpers para barras visuales ──────────────────────────────────────────────
function pct(num: number, den: number) {
  return den > 0 ? Math.round((num / den) * 100) : 0;
}

// ── Donuts para KPIs ──────────────────────────────────────────────────────────
const KPI_R = 22, KPI_C = 2 * Math.PI * KPI_R;
function kpiDash(p: number) {
  return `${(Math.max(0, Math.min(100, p)) / 100) * KPI_C} ${KPI_C}`;
}
---

<Layout
  title="Datos - Sal de ahí - Lo Público"
  description="Cifras y metodología sobre la presencia de instituciones públicas españolas en redes sociales."
  active="datos"
>

  <!-- ── HERO OSCURO (datos) ─────────────────────────────────────────── -->
  <div class="datos-hero">
    <Topbar dark active="datos" />
    <div class="max-w-screen-xl mx-auto px-6 sm:px-14 pt-10 pb-14">
      <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-8 items-end">
        <h1 class="datos-hero-h1">
          Los datos,{" "}
          <span class="datos-hero-h1-serif">en bruto.</span>
        </h1>
        <p class="datos-hero-manifesto">
          Presencia de instituciones y representantes públicos en X/Twitter y alternativas federadas.
        </p>
      </div>
      <div class="datos-hero-meta">
        <div class="datos-hero-meta-text">
          <span class="datos-hero-meta-highlight">{totales.total} entidades</span>
          {" · "}7 categorías{" · "}Actualizado {fmtDate(lastUpdate.twitter)}
        </div>
        <ExportButton client:load dark />
      </div>
    </div>
  </div>

  <!-- Aviso pantalla pequeña -->
  <div class="sm:hidden bg-foreground text-background text-xs px-4 py-3 text-center leading-snug">
    Esta página muestra tablas y gráficos que pueden no verse bien en pantallas pequeñas. Se recomienda acceder desde un dispositivo más grande.
  </div>

  <!-- Toggle Datos / Metodología -->
  <div class="datos-toggle-bar">
    <div class="datos-toggle">
      <button class="datos-toggle-btn is-active" data-show="datos">Datos</button>
      <button class="datos-toggle-btn" data-show="metodologia">Metodología</button>
    </div>
  </div>

  <!-- Panel: Datos -->
  <div id="datos-panel-datos" class="datos-panel">
  <div class="text-left px-4 sm:px-6 max-w-screen-xl mx-auto pb-16 mt-10 space-y-12">

    <!-- ── Presencia registrada ──────────────────────────────────────────── -->
    <div class="datos-section">
      <div class="datos-kpi-grid">

        <!-- Total entidades (sin donut) -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Entidades monitorizadas</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-fg-2)" stroke-width="5"
                stroke-dasharray={kpiDash(100)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num">{totales.total}</p>
              <p class="datos-kpi-sub">en 7 categorías</p>
            </div>
          </div>
        </div>

        <!-- Con X -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Con cuenta en X</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-fg-2)" stroke-width="5"
                stroke-dasharray={kpiDash(pctConTw)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num"><span>{pctNum(totales.conTwitter, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.conTwitter}/{totales.total}</p>
            </div>
          </div>
        </div>

        <!-- Bluesky -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Con cuenta en Bluesky</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-sky)" stroke-width="5"
                stroke-dasharray={kpiDash(pctBsky)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num"><span>{pctNum(totales.conBluesky, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.conBluesky}/{totales.total}</p>
            </div>
          </div>
        </div>

        <!-- Mastodon -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Con cuenta en Mastodon</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-mastodon)" stroke-width="5"
                stroke-dasharray={kpiDash(pctMstdn)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num"><span>{pctNum(totales.conMastodon, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.conMastodon}/{totales.total}</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="datos-callout">
      <p class="datos-callout-text">El <strong>{pctConTw}%</strong> de las entidades monitorizadas tiene cuenta en X/Twitter. Solo el <strong>{pctEnX}%</strong> publicó algo en los últimos 30 días.</p>
    </div>

    <!-- ── Actividad ──────────────────────────────────────────────────────── -->
    <div class="datos-section datos-section--activity">
      <div class="datos-kpi-grid">

        <!-- Activas en X -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Activas en X</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-fg-2)" stroke-width="5"
                stroke-dasharray={kpiDash(pctEnX)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num"><span>{pctNum(totales.enX, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.enX}/{totales.total}</p>
            </div>
          </div>
        </div>

        <!-- Sin alternativa a X -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Sin alternativa a X</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-rose-pink)" stroke-width="5"
                stroke-dasharray={kpiDash(pctNingW)} transform="rotate(-90 27 27)"/>
            </svg>
            <div>
              <p class="datos-kpi-num datos-kpi-num--alert"><span>{pctNum(totales.sinAlternativa, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.sinAlternativa}/{totales.total}</p>
            </div>
          </div>
        </div>

        <!-- Activas en Bluesky -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Activas en Bluesky</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-sky)" stroke-width="5"
                stroke-dasharray={kpiDash(pctActBskyOfTotal)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num"><span>{pctNum(totales.activoBsky, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.activoBsky}/{totales.total}</p>
            </div>
          </div>
        </div>

        <!-- Sin cuenta en ninguna red -->
        <div class="datos-kpi-card">
          <p class="datos-kpi-desc">Sin cuenta en ninguna red</p>
          <div class="datos-kpi-body">
            <svg class="datos-kpi-donut" width="54" height="54" viewBox="0 0 54 54">
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-line)" stroke-width="5"/>
              <circle cx="27" cy="27" r={KPI_R} fill="none" stroke="var(--sd-muted)" stroke-width="5"
                stroke-dasharray={kpiDash(pctSinNinguna)} transform="rotate(-90 27 27)"/>
            </svg>
            <div class="datos-kpi-text">
              <p class="datos-kpi-num"><span>{pctNum(totales.sinNinguna, totales.total)}</span><span>%</span></p>
              <p class="datos-kpi-sub">{totales.sinNinguna}/{totales.total}</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Migración funcional -->
      <div class="sustfunc-banner mt-6">
        <div class="sustfunc-num">{sustFuncionalTotal}</div>
        <div class="sustfunc-text">
          <strong>entidades han migrado funcionalmente</strong> — X inactiva o ausente, con presencia activa en Bluesky o Mastodon
        </div>
      </div>

    </div>

    <!-- ── Distribución por plataforma ────────────────────────────────────── -->
    <div class="datos-section datos-section--activity">
      <p class="datos-section-label datos-section-label--activity">
        Distribución por plataforma
      </p>
      <p class="datos-dist-desc mb-6">Proporción del total de {totales.total} entidades con cuenta registrada (barra completa) y con actividad en los últimos 30 días (tramo oscuro).</p>
      {sustFuncionalTotal > 0 && (
        <div class="datos-callout">
          <p class="datos-callout-text"><strong>{sustFuncionalTotal}</strong> entidades han migrado funcionalmente: están inactivas en X pero activas en una plataforma federada.</p>
        </div>
      )}
      <div class="space-y-5">
        <div>
          <div class="dist-bar-row">
            <span class="dist-bar-label">X / Twitter</span>
            <span class="dist-bar-stats">{totales.conTwitter} con cuenta ({pctFmt(totales.conTwitter, totales.total)}) · {totales.enX} activas ({pctFmt(totales.enX, totales.total)}) · {totales.sinActX} inactivas</span>
          </div>
          <div class="dist-bar-track">
            <div class="dist-bar-seg dist-bar-seg--x-act" data-pct={pctEnX}></div>
            <div class="dist-bar-seg dist-bar-seg--x-inact" data-pct={pctConTw - pctEnX}></div>
          </div>
        </div>
        <div>
          <div class="dist-bar-row">
            <span class="dist-bar-label">Bluesky</span>
            <span class="dist-bar-stats">{totales.conBluesky} con cuenta ({pctFmt(totales.conBluesky, totales.total)}) · {totales.activoBsky} activas ({pctFmt(totales.activoBsky, totales.total)} del total)</span>
          </div>
          <div class="dist-bar-track">
            <div class="dist-bar-seg dist-bar-seg--bsky-act" data-pct={pctActBskyOfTotal}></div>
            <div class="dist-bar-seg dist-bar-seg--bsky-inact" data-pct={pctBsky - pctActBskyOfTotal}></div>
          </div>
        </div>
        <div>
          <div class="dist-bar-row">
            <span class="dist-bar-label">Mastodon</span>
            <span class="dist-bar-stats">{totales.conMastodon} con cuenta ({pctFmt(totales.conMastodon, totales.total)}) · {totales.activoMstdn} activas ({pctFmt(totales.activoMstdn, totales.total)} del total)</span>
          </div>
          <div class="dist-bar-track">
            <div class="dist-bar-seg dist-bar-seg--mstdn-act" data-pct={pctActMstdnOfTotal}></div>
            <div class="dist-bar-seg dist-bar-seg--mstdn-inact" data-pct={pctMstdn - pctActMstdnOfTotal}></div>
          </div>
        </div>
        <p class="datos-proto-note"><strong>Nota:</strong> Bluesky (AT Protocol) y Mastodon (ActivityPub) son protocolos distintos con diferente nivel de apertura. ActivityPub es un estándar del W3C sin propietario comercial; AT Protocol está controlado por Bluesky Social PBC, una empresa privada con financiación de capital riesgo. <a href="/porque" class="datos-meto-link">Más información</a>.</p>
        <div>
          <div class="dist-bar-row">
            <span class="dist-bar-label dist-bar-label--alert">Sin alternativa a X <span class="dist-bar-label-note">(sin Bluesky ni Mastodon)</span></span>
            <span class="dist-bar-stats">{totales.sinAlternativa} ({pctFmt(totales.sinAlternativa, totales.total)})</span>
          </div>
          <div class="dist-bar-track">
            <div class="dist-bar-seg dist-bar-seg--sin-alt" data-pct={pctNingW}></div>
          </div>
        </div>
      </div>
      <div class="dist-legend">
        <span class="dist-legend-item">
          <span class="dist-legend-swatches">
            <span class="dist-legend-swatch dist-legend-swatch--x-act"></span>
            <span class="dist-legend-swatch dist-legend-swatch--bsky-act"></span>
            <span class="dist-legend-swatch dist-legend-swatch--mstdn-act"></span>
          </span>
          Activas (últimos 30 días)
        </span>
        <span class="dist-legend-item">
          <span class="dist-legend-swatches">
            <span class="dist-legend-swatch dist-legend-swatch--x-inact"></span>
            <span class="dist-legend-swatch dist-legend-swatch--bsky-inact"></span>
            <span class="dist-legend-swatch dist-legend-swatch--mstdn-inact"></span>
          </span>
          Con cuenta, sin actividad reciente
        </span>
        <span class="dist-legend-item">
          <span class="dist-legend-swatch dist-legend-swatch--sin-alt"></span>
          Sin alternativa a X
        </span>
      </div>
    </div>

    <!-- ── Por categoría (toggle visual / tabla) ───────────────────────────── -->
    <div>
      <h2 class="text-base font-semibold mb-1 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-muted-foreground shrink-0">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        Adopción por categoría
      </h2>

      <!-- Toggle visual / calor / tabla -->
      <div class="datos-toggle mb-4" id="cat-toggle">
        <button class="datos-toggle-btn" data-cat="visual">Barras</button>
        <button class="datos-toggle-btn is-active" data-cat="calor">Mapa de calor</button>
        <button class="datos-toggle-btn" data-cat="tabla">Tabla</button>
      </div>

      <!-- Panel: visual -->
      <div id="cat-panel-visual" class="cat-panel cat-panel--hidden">
      <p class="text-sm text-muted-foreground mb-6">Presencia y actividad en cada plataforma como proporción del total de entidades de cada categoría.</p>

      <!-- Eje de referencia -->
      <div class="flex gap-0 mb-1 ml-[7rem] sm:ml-[9rem]">
        <div class="flex-1 flex justify-between pr-10 sm:pr-12">
          {[0,25,50,75,100].map(v => (
            <span class={`cat-axis-label${v > 0 ? ' cat-axis-label--shift' : ''}`}>{v}%</span>
          ))}
        </div>
      </div>
      <!-- Líneas guía -->
      <div class="relative space-y-4">
        <div class="absolute inset-y-0 ml-[7rem] sm:ml-[9rem] right-10 sm:right-12 pointer-events-none flex">
          {[25,50,75].map(v => (
            <div class="cat-guide-line" data-left={v}></div>
          ))}
        </div>

        {catStats.map(c => {
          const pXA  = pct(c.enX, c.total);
          const pXI  = pct(c.sinActX, c.total);
          const pBsA = pct(c.activoBsky, c.total);
          const pBsI = pct(c.conBluesky - c.activoBsky, c.total);
          const pMd  = pct(c.conMastodon, c.total);
          return (
            <div class="flex gap-2 sm:gap-3 items-start">
              <div class="w-28 sm:w-36 shrink-0 text-right pt-0.5">
                <div class="text-sm font-medium leading-tight">{c.label}</div>
                <div class="text-xs text-muted-foreground/50">{c.total} entidades</div>
              </div>
              <div class="flex-1 space-y-1.5">
                <div class="flex items-center gap-2 cursor-default" data-tip={`X / Twitter — ${c.enX} activas, ${c.sinActX} inactivas (${c.conTwitter} con cuenta)`}>
                  <div class="flex flex-1 h-2 overflow-hidden bg-border/20">
                    <div class="dist-bar-seg dist-bar-seg--x-act" data-pct={pXA}></div>
                    <div class="dist-bar-seg dist-bar-seg--x-inact" data-pct={pXI}></div>
                  </div>
                  <span class="text-xs tabular-nums text-muted-foreground w-8 text-right shrink-0">{pXA}%</span>
                </div>
                <div class="flex items-center gap-2 cursor-default" data-tip={`Bluesky — ${c.activoBsky} activas, ${c.conBluesky - c.activoBsky} inactivas (${c.conBluesky} con cuenta)`}>
                  <div class="flex flex-1 h-2 overflow-hidden bg-border/20">
                    <div class="dist-bar-seg dist-bar-seg--bsky-act" data-pct={pBsA}></div>
                    <div class="dist-bar-seg dist-bar-seg--bsky-inact" data-pct={pBsI}></div>
                  </div>
                  <span class="text-xs tabular-nums text-muted-foreground w-8 text-right shrink-0">{pBsA}%</span>
                </div>
                <div class="flex items-center gap-2 cursor-default" data-tip={`Mastodon — ${c.conMastodon} con cuenta`}>
                  <div class="flex flex-1 h-2 overflow-hidden bg-border/20">
                    <div class="dist-bar-seg dist-bar-seg--mstdn-act" data-pct={pMd}></div>
                  </div>
                  <span class="text-xs tabular-nums text-muted-foreground w-8 text-right shrink-0">{pMd}%</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="text-sm text-muted-foreground/70 mt-5 flex flex-wrap gap-x-5 gap-y-1.5">
        <span class="flex items-center gap-1.5">
          <span class="inline-flex gap-px shrink-0"><span class="inline-block w-2 h-2 bg-foreground/75 rounded-sm"></span><span class="inline-block w-2 h-2 bg-foreground/20 rounded-sm"></span></span>
          X: activas · con cuenta sin actividad
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-flex gap-px shrink-0"><span class="inline-block w-2 h-2 bg-sky-500/80 rounded-sm"></span><span class="inline-block w-2 h-2 bg-sky-500/25 rounded-sm"></span></span>
          Bluesky: activas · con cuenta sin actividad
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 bg-violet-500/70 rounded-sm shrink-0"></span>
          Mastodon
        </span>
      </div>
      </div><!-- end cat-panel-visual -->

      <!-- Panel: mapa de calor -->
      <div id="cat-panel-calor" class="cat-panel">
        <p class="text-sm text-muted-foreground mb-5">% de entidades con actividad en los últimos 30 días sobre el total de cada categoría. La intensidad de color refleja el porcentaje.</p>
        <div class="heatmap-wrap">
          <div class="heatmap-grid">
            <div></div>
            <div class="heatmap-col-head heatmap-col-head--x">X / Twitter</div>
            <div class="heatmap-col-head heatmap-col-head--bsky">Bluesky</div>
            <div class="heatmap-col-head heatmap-col-head--mstdn">Mastodon</div>
            {catStats.map(c => {
              const pX  = pct(c.enX,         c.total);
              const pBs = pct(c.activoBsky,   c.total);
              const pMd = pct(c.activoMstdn,  c.total);
              const aX  = (0.05 + (pX  / 100) * 0.50).toFixed(3);
              const aBs = (0.05 + (pBs / 100) * 0.55).toFixed(3);
              const aMd = (0.05 + (pMd / 100) * 0.55).toFixed(3);
              return <>
                <div class="heatmap-row-lbl">
                  <span class="heatmap-row-name">{c.label}</span>
                  <span class="heatmap-row-n">{c.total}</span>
                </div>
                <div class="heatmap-cell" style={`background:rgba(20,20,20,${aX})`}>
                  <span class="heatmap-val">{pX}%</span>
                  <span class="heatmap-sub">{c.enX}/{c.total}</span>
                </div>
                <div class="heatmap-cell" style={`background:rgba(0,133,255,${aBs})`}>
                  <span class="heatmap-val">{pBs}%</span>
                  <span class="heatmap-sub">{c.activoBsky}/{c.total}</span>
                </div>
                <div class="heatmap-cell" style={`background:rgba(115,90,220,${aMd})`}>
                  <span class="heatmap-val">{pMd}%</span>
                  <span class="heatmap-sub">{c.activoMstdn}/{c.total}</span>
                </div>
              </>;
            })}
          </div>
        </div>
      </div><!-- end cat-panel-calor -->

      <!-- Panel: tabla numérica (Desglose por categoría) -->
      <div id="cat-panel-tabla" class="cat-panel cat-panel--hidden">
      <p class="text-sm text-muted-foreground mb-4"><em>Activos X</em>: con publicación en X en los últimos 30 días. <em>Sin act. X</em>: con cuenta pero sin publicar en ese período. <em>Con X</em>: total con cuenta en X. <em>Sin redes</em>: sin cuenta en ninguna plataforma.</p>
      <div class="overflow-x-auto border border-border/50">
        <table class="w-full" data-sortable>
          <thead>
            <tr class="border-b border-border/40 bg-muted/20">
              <th data-sort="cat"     class="datos-sortable-th py-3 px-5 text-xs font-medium text-muted-foreground text-left  whitespace-nowrap">Categoría<span class="datos-sort-ind"></span></th>
              <th data-sort="total"   class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Total<span class="datos-sort-ind"></span></th>
              <th data-sort="sinAlt"  class="datos-sortable-th py-3 px-4 text-xs font-medium text-right whitespace-nowrap datos-th--alert">Sin alt. X<span class="datos-sort-ind"></span></th>
              <th data-sort="enX"     class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Activos X<span class="datos-sort-ind"></span></th>
              <th data-sort="sinActX" class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Sin act. X<span class="datos-sort-ind"></span></th>
              <th data-sort="conTw"   class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Con X<span class="datos-sort-ind"></span></th>
              <th data-sort="bsky"    class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Bluesky<span class="datos-sort-ind"></span></th>
              <th data-sort="bskyA"   class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Activos BS<span class="datos-sort-ind"></span></th>
              <th data-sort="mstdn"   class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Mastodon<span class="datos-sort-ind"></span></th>
              <th data-sort="sinNada" class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Sin redes<span class="datos-sort-ind"></span></th>
            </tr>
          </thead>
          <tbody>
            {catStats.map((c) => (
              <tr class="border-b border-border/30 hover:bg-muted/20 transition-colors">
                <td data-col="cat"     class="py-3 px-5 text-sm font-medium text-left whitespace-nowrap">{c.label}</td>
                <td data-col="total"   data-val={c.total}          class="py-3 px-4 text-sm tabular-nums text-right text-muted-foreground">{c.total}</td>
                <td data-col="sinAlt"  data-val={c.sinAlternativa} class={`py-3 px-4 text-sm tabular-nums text-right font-medium ${c.sinAlternativa > 0 ? 'datos-td--alert' : 'text-muted-foreground'}`}>{c.sinAlternativa}</td>
                <td data-col="enX"     data-val={c.enX}            class="py-3 px-4 text-sm tabular-nums text-right">{c.enX}</td>
                <td data-col="sinActX" data-val={c.sinActX}        class="py-3 px-4 text-sm tabular-nums text-right text-muted-foreground">{c.sinActX}</td>
                <td data-col="conTw"   data-val={c.conTwitter}     class="py-3 px-4 text-sm tabular-nums text-right text-muted-foreground">{c.conTwitter}</td>
                <td data-col="bsky"    data-val={c.conBluesky}     class="py-3 px-4 text-sm tabular-nums text-right">{c.conBluesky}</td>
                <td data-col="bskyA"   data-val={c.activoBsky}     class="py-3 px-4 text-sm tabular-nums text-right font-medium">{c.activoBsky}</td>
                <td data-col="mstdn"   data-val={c.conMastodon}    class="py-3 px-4 text-sm tabular-nums text-right">{c.conMastodon}</td>
                <td data-col="sinNada" data-val={c.sinNinguna}     class="py-3 px-4 text-sm tabular-nums text-right text-muted-foreground">{c.sinNinguna}</td>
              </tr>
            ))}
            <tr data-footer class="border-t border-border bg-muted/20">
              <td class="py-3 px-5 text-sm font-semibold text-left">Total</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right text-muted-foreground">{totales.total}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right datos-td--alert">{totales.sinAlternativa}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right">{totales.enX}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right text-muted-foreground">{totales.sinActX}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right text-muted-foreground">{totales.conTwitter}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right">{totales.conBluesky}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right">{totales.activoBsky}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right">{totales.conMastodon}</td>
              <td class="py-3 px-4 text-sm tabular-nums font-semibold text-right text-muted-foreground">{totales.sinNinguna}</td>
            </tr>
          </tbody>
        </table>
      </div>
      </div><!-- end cat-panel-tabla -->
    </div>

    <!-- ── Presencia por grupo parlamentario ───────────────────────────────── -->
    <div>
      <h2 class="text-base font-semibold mb-1 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-muted-foreground shrink-0">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Presencia por grupo parlamentario
      </h2>
      <p class="text-sm text-muted-foreground mb-4">XV Legislatura. Solo diputados/as y senadores/as con escaño actual; no incluye presidencia de cámara ni grupos como entidad.</p>

      <div class="datos-callout">
        <p class="datos-callout-text">El grupo parlamentario predice con alta precisión si un diputado usa Bluesky: desde el <strong>{bskyMaxGrupo.pctBsky}%</strong> de {bskyMaxGrupo.label} hasta el <strong>{bskyMinGrupo.pctBsky}%</strong> del {bskyMinGrupo.label}.</p>
      </div>

      <!-- Toggle Congreso / Senado -->
      <div class="datos-toggle mb-6" id="parl-toggle">
        <button class="datos-toggle-btn is-active" data-parl="congreso">Congreso de los Diputados</button>
        <button class="datos-toggle-btn" data-parl="senado">Senado de España</button>
      </div>

      <!-- Congreso -->
      <div id="parl-panel-congreso" class="parl-panel">

      <!-- Gradiente ideológico -->
      <div class="gradiente-wrap mb-8">
        <p class="gradiente-title">Adopción de Bluesky por grupo parlamentario (Congreso)</p>
        <p class="gradiente-subtitle">% de diputados con cuenta en Bluesky. De izquierda a derecha según orientación ideológica habitual.</p>
        <div class="gradiente-chart">
          {gruposGradiente.map(g => (
            <div class="gradiente-row">
              <span class="gradiente-label">{g.label}</span>
              <div class="gradiente-bar-track">
                <div class="gradiente-bar-fill" style={`width:${g.pctBsky}%`}></div>
              </div>
              <span class="gradiente-pct">{g.pctBsky}%</span>
            </div>
          ))}
        </div>
      </div>

      <div class="overflow-x-auto border border-border/50 mb-8">
        <table class="w-full" data-sortable>
          <thead>
            <tr class="border-b border-border/40 bg-muted/20">
              <th data-sort="grupo"    class="datos-sortable-th py-3 px-5 text-xs font-medium text-muted-foreground text-left whitespace-nowrap">Grupo<span class="datos-sort-ind"></span></th>
              <th data-sort="total"   class="datos-sortable-th py-3 px-4 text-xs font-medium text-muted-foreground text-right whitespace-nowrap">Total<span class="datos-sort-ind"></span></th>
              <th data-sort="sinAlt"  class="datos-sortable-th py-3 px-4 text-xs font-medium text-right whitespace-nowrap datos-th--alert">Sin alternativa<span class="datos-sort-ind"></span></th>
