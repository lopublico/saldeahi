<Tabs grupo="cat" class="shrink-0" etiqueta="Vista de la adopción por categoría" opciones={[{ valor: "calor", texto: "Mapa de calor" }, { valor: "visual", texto: "Gráfico comparativo" }, { valor: "tabla", texto: "Tabla detallada" }]} />
      </Fragment>

