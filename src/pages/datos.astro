                <span>Tasa de actividad sobre sus cuentas</span>
                <span class="font-mono font-medium">{totales.conMastodon > 0 ? Math.round((totales.activoMstdn / totales.conMastodon) * 100) : 0}%</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Indicadores: Sin alternativa y Migración funcional -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Sin alternativa a X -->
        <div class="datos-highlight-card datos-highlight-card--alert">
          <div class="datos-highlight-head">
            <h4 class="datos-highlight-title text-[var(--sd-rose-pink)]">Sin alternativa a X</h4>
            <span class="datos-highlight-stat font-mono text-rose-700">{totales.sinAlternativa} entidades ({pctNingW}%)</span>
