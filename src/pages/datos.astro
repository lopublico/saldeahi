          { ayuda: 'Con publicación en X en los últimos 30 días', clave: 'enX', titulo: 'Activos X', alinear: 'der', primera: 'desc' },
          { ayuda: 'Con cuenta en X pero sin publicar en los últimos 30 días', clave: 'sinActX', titulo: 'Sin act. X', alinear: 'der', primera: 'desc' },
