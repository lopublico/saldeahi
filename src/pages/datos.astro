---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Panel from "@lopublico/ui/Panel.astro";
import Donut from "@lopublico/ui/Donut.astro";
import Tabs from "@lopublico/ui/Tabs.astro";
import Tabla from "@lopublico/ui/Tabla.astro";
import Barra from "@lopublico/ui/Barra.astro";
import MapaCalor from "@lopublico/ui/MapaCalor.astro";
import AvisoMovil from "@lopublico/ui/AvisoMovil.astro";
import DescargaDatos from "@lopublico/ui/DescargaDatos.astro";
import StatCard from "@lopublico/ui/StatCard.astro";
import BarraProporcion from "@lopublico/ui/BarraProporcion.astro";
import lastUpdateData from "@/data/lastUpdate.json";
import ageData from "@/data/age.json";
import organosData from "@/data/organos.json";
import gobiernoData from "@/data/gobierno.json";
import congresoData from "@/data/congreso.json";
import senadoData from "@/data/senado.json";
import partidosData from "@/data/partidos.json";
import autonomiasData from "@/data/autonomias.json";
import universidadesData from "@/data/universidades.json";

const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
const lastUpdate = lastUpdateData as any;

function platformRef(d: string | undefined) {
  return d ? new Date(d + "T00:00:00Z").getTime() : Date.now();
}
const TWITTER_REF  = platformRef(lastUpdate.twitter);
const BLUESKY_REF  = platformRef(lastUpdate.bluesky);
const MASTODON_REF = platformRef(lastUpdate.mastodon);

function isActiveDate(val: unknown, ref: number): boolean {
  if (!val || typeof val !== "string") return false;
  if (!/^\d{4}-\d{2}-\d{2}/.test(val)) return false;
  return ref - new Date(val).getTime() <= THIRTY_DAYS_MS;
}
function twitterOnX(handle: unknown, activo: unknown): boolean {
  if (!handle) return false;
  if (activo == null) return false;
  return isActiveDate(activo, TWITTER_REF);
}
function normalizeItem(item: any) {
  const tw = String(item.twitter_activo ?? "").startsWith("404") ? null : (item.twitter || null);
  return {
    twitter:         tw,
    twitter_activo:  twitterOnX(tw, item.twitter_activo),
    bluesky:         item.bluesky  || null,
    bluesky_activo:  isActiveDate(item.bluesky_activo, BLUESKY_REF),
    bluesky_eurosky: !!item.bluesky_eurosky,
    mastodon:        item.mastodon || null,
    mastodon_activo: isActiveDate(item.mastodon_activo, MASTODON_REF),
    grupo:           item.grupo || null,
    tipo:            item.tipo || null,
  };
}

const ADMIN_TIPOS = new Set([
  "Presidencia del Gobierno", "Ministerio", "Secretaría de Estado",
  "Delegación del Gobierno", "Seguridad y Defensa",
]);
const EMPRESAS_TIPOS = new Set([
  "Entidad Pública Empresarial", "Sociedad Mercantil Estatal", "Fundación Estatal",
]);
const ageAdministracion = (ageData as any[]).filter((x) => ADMIN_TIPOS.has(x.categoria));
const ageEmpresas       = (ageData as any[]).filter((x) => EMPRESAS_TIPOS.has(x.categoria));
const ageOrganismos     = (ageData as any[]).filter(
  (x) => !ADMIN_TIPOS.has(x.categoria) && !EMPRESAS_TIPOS.has(x.categoria));

const AUTONOMIAS_INSTITUCIONAL_TIPOS = new Set(["Presidente/a", "Gobierno", "Parlamento"]);
const autonomiasInstitucional = (autonomiasData as any[]).filter(
  (x) => AUTONOMIAS_INSTITUCIONAL_TIPOS.has(x.tipo));
const organismosAutonomicos = (autonomiasData as any[]).filter(
  (x) => !AUTONOMIAS_INSTITUCIONAL_TIPOS.has(x.tipo));

const CATEGORIES = [
  { key: "administracion", label: "Administración",         data: ageAdministracion },
  { key: "organismos",     label: "Organismos públicos",    data: ageOrganismos     },
  { key: "empresas",       label: "Empresas y fundaciones", data: ageEmpresas       },
  { key: "organos",       label: "Órganos del Estado", data: organosData    },
  { key: "gobierno",      label: "Gobierno",         data: gobiernoData      },
  { key: "congreso",      label: "Congreso",         data: congresoData      },
  { key: "senado",        label: "Senado",           data: senadoData        },
  { key: "partidos",      label: "Partidos",         data: partidosData      },
  { key: "autonomias",    label: "Autonomías",       data: autonomiasInstitucional },
  { key: "organismosautonomicos", label: "Organismos autonómicos", data: organismosAutonomicos },
  { key: "universidades", label: "Universidades",    data: universidadesData },
];

const catStats = CATEGORIES.map(({ key, label, data }) => {
  const items = (data as any[]).map(normalizeItem);
  const total          = items.length;
  const conTwitter     = items.filter(x => x.twitter).length;
  const enX            = items.filter(x => x.twitter_activo).length;
  const sinActX        = conTwitter - enX;
  const conBluesky     = items.filter(x => x.bluesky).length;
  const activoBsky     = items.filter(x => x.bluesky_activo).length;
  const conMastodon    = items.filter(x => x.mastodon).length;
  const activoMstdn    = items.filter(x => x.mastodon_activo).length;
  const sinAlternativa = items.filter(x => x.twitter && !x.bluesky && !x.mastodon).length;
  const sinNinguna     = items.filter(x => !x.twitter && !x.bluesky && !x.mastodon).length;
  // Base de las estadísticas de elección de plataforma: excluye las entidades sin
  // presencia en ninguna red (no participaron de la elección X/Bluesky/Mastodon).
  const base           = total - sinNinguna;
  const pctFuera       = base > 0 ? Math.round(((base - enX) / base) * 100) : 0;
  const pctBsky        = base > 0 ? Math.round((conBluesky / base) * 100) : 0;
  return { key, label, total, base, conTwitter, enX, sinActX, conBluesky, activoBsky, conMastodon, activoMstdn, sinAlternativa, sinNinguna, pctFuera, pctBsky };
});

const totales = catStats.reduce(
  (acc, c) => ({
    total:          acc.total          + c.total,
    conTwitter:     acc.conTwitter     + c.conTwitter,
    enX:            acc.enX            + c.enX,
    sinActX:        acc.sinActX        + c.sinActX,
    conBluesky:     acc.conBluesky     + c.conBluesky,
    activoBsky:     acc.activoBsky     + c.activoBsky,
    conMastodon:    acc.conMastodon    + c.conMastodon,
    activoMstdn:    acc.activoMstdn    + c.activoMstdn,
    sinAlternativa: acc.sinAlternativa + c.sinAlternativa,
    sinNinguna:     acc.sinNinguna     + c.sinNinguna,
  }),
  { total: 0, conTwitter: 0, enX: 0, sinActX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, activoMstdn: 0, sinAlternativa: 0, sinNinguna: 0 }
);

const conAlternativa    = totales.total - totales.sinAlternativa;
// Base de las estadísticas de elección de plataforma en todo el sitio: excluye
// las entidades sin presencia en ninguna red (no participaron de la elección
// X/Bluesky/Mastodon), tal y como hace el paper. Siguen apareciendo en las tablas.
const totalesBase       = totales.total - totales.sinNinguna;

const allNormalizedItems = CATEGORIES.flatMap(({ data }) => (data as any[]).map(normalizeItem));
const sustFuncionalTotal = allNormalizedItems.filter(x => !x.twitter_activo && (x.bluesky_activo || x.mastodon_activo)).length;

function pctVal(num: number, den: number) {
  return den > 0 ? Math.round((num / den) * 100) : 0;
}
function pctFmt(num: number, den: number) {
  const v = pctVal(num, den);
  return v === 0 && num > 0 ? "~0%" : `${v}%`;
}
function pctNum(num: number, den: number) {
  const v = pctVal(num, den);
  return v === 0 && num > 0 ? "~0" : `${v}`;
}

const pctFueraDeX       = pctVal(totalesBase - totales.enX, totalesBase);
const pctEnX            = pctVal(totales.enX,        totalesBase);
const pctConTw          = pctVal(totales.conTwitter, totalesBase);
const pctBsky           = pctVal(totales.conBluesky, totalesBase);
const pctActivoBsky     = pctVal(totales.activoBsky, totales.conBluesky);
const pctMstdn          = pctVal(totales.conMastodon, totalesBase);
const pctActivoMstdn    = pctVal(totales.activoMstdn, totales.conMastodon);
const pctSinNinguna     = pctVal(totales.sinNinguna,  totales.total);
const pctNingW          = pctVal(totales.sinAlternativa, totalesBase);
const pctSinActX        = pctVal(totales.sinActX,     totalesBase);
const pctActBskyOfTotal = pctVal(totales.activoBsky,  totalesBase);
const pctActMstdnOfTotal= pctVal(totales.activoMstdn, totalesBase);
const pctSustFunc       = pctVal(sustFuncionalTotal,  totalesBase);

// ── Stats de error 404 en Twitter (para metodología) ─────────────────────────
const allItems = CATEGORIES.flatMap(({ data }) => data as any[]);
const tw404Count = allItems.filter(r => r.twitter && String(r.twitter_activo ?? "").startsWith("404")).length;
const twTotal    = allItems.filter(r => r.twitter).length;
const tw404Pct   = twTotal > 0 ? (tw404Count / twTotal * 100).toFixed(1) : "0";
const twRefMes   = lastUpdate.twitter
  ? new Date(lastUpdate.twitter + "T00:00:00Z").toLocaleDateString("es-ES", { month: "long", year: "numeric", timeZone: "UTC" })
  : "";

// ── Congreso: por grupo parlamentario (solo diputados) ────────────────────────
const CONGRESO_GRUPO_LABELS: Record<string, string> = {
  "Grupo Parlamentario Popular en el Congreso":   "PP",
  "Grupo Parlamentario Socialista":               "PSOE",
  "Grupo Parlamentario VOX":                      "VOX",
  "Grupo Parlamentario Plurinacional SUMAR":      "SUMAR",
  "Grupo Parlamentario Mixto":                    "Mixto",
  "Grupo Parlamentario Junts per Catalunya":      "Junts",
  "Grupo Parlamentario Republicano":              "ERC",
  "Grupo Parlamentario Euskal Herria Bildu":      "EH Bildu",
  "Grupo Parlamentario Vasco (EAJ-PNV)":          "PNV",
};

type GrupoStat = { total: number; enX: number; fueraDeX: number; conBluesky: number; activoBsky: number; conMastodon: number; sinAlternativa: number; sinNinguna: number };

const congresoGruposMap: Record<string, GrupoStat> = {};

for (const raw of congresoData as any[]) {
  if (raw.tipo !== "Diputado/a" || !raw.grupo) continue;
  const label = CONGRESO_GRUPO_LABELS[raw.grupo] ?? raw.grupo;
  if (!congresoGruposMap[label]) congresoGruposMap[label] = { total: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0, sinNinguna: 0 };
  const g = congresoGruposMap[label];
  const item = normalizeItem(raw);
  g.total++;
  if (item.twitter_activo) g.enX++; else g.fueraDeX++;
  if (item.bluesky)        g.conBluesky++;
  if (item.bluesky_activo) g.activoBsky++;
  if (item.mastodon)       g.conMastodon++;
  if (item.twitter && !item.bluesky && !item.mastodon) g.sinAlternativa++;
  if (!item.twitter && !item.bluesky && !item.mastodon) g.sinNinguna++;
}

const CONGRESO_GRUPO_ORDER = ["PP", "PSOE", "VOX", "SUMAR", "ERC", "EH Bildu", "Junts", "PNV", "Mixto"];
const gruposStats = CONGRESO_GRUPO_ORDER
  .filter(k => congresoGruposMap[k])
  .map(k => {
    const g = congresoGruposMap[k];
    const base = g.total - g.sinNinguna;
    const fueraDeX = Math.max(0, base - g.enX);
    return {
      label: k, ...g, base, fueraDeX,
      pctFuera:  pct(fueraDeX,         base),
      pctBsky:   pct(g.conBluesky,     base),
      pctEnX:    pct(g.enX,            base),
      pctBskyA:  pct(g.activoBsky,     base),
      pctMstdn:  pct(g.conMastodon,    base),
      pctSinAlt: pct(g.sinAlternativa, base),
    };
  });

const congresoTotales = gruposStats.reduce(
  (acc, g) => ({ total: acc.total + g.total, base: acc.base + g.base, enX: acc.enX + g.enX, fueraDeX: acc.fueraDeX + g.fueraDeX, conBluesky: acc.conBluesky + g.conBluesky, activoBsky: acc.activoBsky + g.activoBsky, conMastodon: acc.conMastodon + g.conMastodon, sinAlternativa: acc.sinAlternativa + g.sinAlternativa }),
  { total: 0, base: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0 }
);

// ── Senado: por grupo parlamentario ───────────────────────────────────────────
const SENADO_GRUPO_LABELS: Record<string, string> = {
  "GPP":   "PP",
  "GPS":   "PSOE",
  "GPERB": "ERC / EH Bildu",
  "GPIC":  "Izq. Confederal",
  "GPPLU": "Plural",
  "GPV":   "PNV",
  "GPMX":  "Mixto",
};

const CONGRESO_GRUPO_FULLNAMES: Record<string, string> = {
  "PP":       "Partido Popular",
  "PSOE":     "Partido Socialista Obrero Español",
  "VOX":      "VOX",
  "SUMAR":    "Sumar",
  "ERC":      "Esquerra Republicana de Catalunya",
  "EH Bildu": "Euskal Herria Bildu",
  "Junts":    "Junts per Catalunya",
  "PNV":      "EAJ-PNV",
  "Mixto":    "Grupo Parlamentario Mixto",
};

const SENADO_GRUPO_FULLNAMES: Record<string, string> = {
  "PP":              "Partido Popular",
  "PSOE":            "Partido Socialista Obrero Español",
  "ERC / EH Bildu":  "Izquierdas por la Independencia (ERC + EH Bildu)",
  "Izq. Confederal": "Izquierda Confederal (Más Madrid, Compromís, ASG, Geroa Bai…)",
  "Plural":          "Grupo Plural (Junts, Coalición Canaria, BNG, AHI)",
  "PNV":             "Euzko Alderdi Jeltzalea – Partido Nacionalista Vasco",
  "Mixto":           "Grupo Parlamentario Mixto",
};

const senadoGruposMap: Record<string, GrupoStat> = {};

for (const raw of senadoData as any[]) {
  if (raw.tipo !== "Senador/a" || !raw.grupo) continue;
  const label = SENADO_GRUPO_LABELS[raw.grupo] ?? raw.grupo;
  if (!senadoGruposMap[label]) senadoGruposMap[label] = { total: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0, sinNinguna: 0 };
  const g = senadoGruposMap[label];
  const item = normalizeItem(raw);
  g.total++;
  if (item.twitter_activo) g.enX++; else g.fueraDeX++;
  if (item.bluesky)        g.conBluesky++;
  if (item.bluesky_activo) g.activoBsky++;
  if (item.mastodon)       g.conMastodon++;
  if (item.twitter && !item.bluesky && !item.mastodon) g.sinAlternativa++;
  if (!item.twitter && !item.bluesky && !item.mastodon) g.sinNinguna++;
}

const SENADO_GRUPO_ORDER = ["PP", "PSOE", "ERC / EH Bildu", "Izq. Confederal", "Plural", "PNV", "Mixto"];
const senadoGruposStats = SENADO_GRUPO_ORDER
  .filter(k => senadoGruposMap[k])
  .map(k => {
    const g = senadoGruposMap[k];
    const base = g.total - g.sinNinguna;
    const fueraDeX = Math.max(0, base - g.enX);
    return {
      label: k, ...g, base, fueraDeX,
      pctFuera:  pct(fueraDeX,         base),
      pctBsky:   pct(g.conBluesky,     base),
      pctEnX:    pct(g.enX,            base),
      pctBskyA:  pct(g.activoBsky,     base),
      pctMstdn:  pct(g.conMastodon,    base),
      pctSinAlt: pct(g.sinAlternativa, base),
    };
  });

const senadoTotales = senadoGruposStats.reduce(
  (acc, g) => ({ total: acc.total + g.total, base: acc.base + g.base, enX: acc.enX + g.enX, fueraDeX: acc.fueraDeX + g.fueraDeX, conBluesky: acc.conBluesky + g.conBluesky, activoBsky: acc.activoBsky + g.activoBsky, conMastodon: acc.conMastodon + g.conMastodon, sinAlternativa: acc.sinAlternativa + g.sinAlternativa }),
  { total: 0, base: 0, enX: 0, fueraDeX: 0, conBluesky: 0, activoBsky: 0, conMastodon: 0, sinAlternativa: 0 }
);

// ── Gradiente ideológico (orden izq→der) ──────────────────────────────────────
const GRADIENTE_ORDER = ["SUMAR", "EH Bildu", "ERC", "Mixto", "PSOE", "Junts", "PNV", "VOX", "PP"];
const gruposGradiente = GRADIENTE_ORDER
  .map(k => gruposStats.find(g => g.label === k))
  .filter((g): g is NonNullable<typeof g> => g != null);
const bskyMaxGrupo = gruposStats.reduce((a, b) => a.pctBsky >= b.pctBsky ? a : b, gruposStats[0]);
const bskyMinGrupo = gruposStats.reduce((a, b) => a.pctBsky <= b.pctBsky ? a : b, gruposStats[0]);

const SENADO_GRADIENTE_ORDER = ["Izq. Confederal", "ERC / EH Bildu", "PSOE", "Plural", "PNV", "Mixto", "PP"];
const senadoGruposGradiente = SENADO_GRADIENTE_ORDER
  .map(k => senadoGruposStats.find(g => g.label === k))
  .filter((g): g is NonNullable<typeof g> => g != null);
const senadoBskyMax = senadoGruposStats.reduce((a, b) => a.pctBsky >= b.pctBsky ? a : b, senadoGruposStats[0]);

function fmtDate(d: string | undefined) {
  if (!d) return "—";
  return new Date(d + "T00:00:00Z").toLocaleDateString("es-ES", {
    day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}

// ── Helpers para barras visuales ──────────────────────────────────────────────
function pct(num: number, den: number) {
  return den > 0 ? Math.round((num / den) * 100) : 0;
}

// ── Donuts para KPIs ──────────────────────────────────────────────────────────
const KPI_R = 22, KPI_C = 2 * Math.PI * KPI_R;
function kpiDash(p: number) {
  return `${(Math.max(0, Math.min(100, p)) / 100) * KPI_C} ${KPI_C}`;
}
---

<Layout
  title="Datos - Sal de ahí - Lo Público"
  description="Cifras y metodología sobre la presencia de instituciones públicas españolas en redes sociales."
  active="datos"
>

  <!-- ── HERO OSCURO (datos) ─────────────────────────────────────────── -->
  <div class="datos-hero">
    <Topbar dark active="datos" />
    <div class="max-w-screen-xl mx-auto px-4 sm:px-8 lg:px-12 pt-10 pb-14">
      <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-8 items-end">
        <h1 class="datos-hero-h1">
          Los datos,{" "}
          <span class="datos-hero-h1-serif">en bruto.</span>
        </h1>
        <p class="datos-hero-manifesto">
          Presencia de instituciones y representantes públicos en X/Twitter y alternativas federadas.
        </p>
      </div>
      <div class="datos-hero-meta">
        <div class="datos-hero-meta-text">
          <span class="datos-hero-meta-highlight">{totales.total} entidades</span>
          {" · "}{CATEGORIES.length} categorías{" · "}Actualizado {fmtDate(lastUpdate.twitter)}
        </div>
        <DescargaDatos url="https://zenodo.org/records/20692749" texto="Descarga de datos" tono="oscuro" />
      </div>
    </div>
  </div>

  <AvisoMovil />

  <!-- Toggle Datos / Metodología -->
  <div class="datos-toggle-bar">
    <Tabs grupo="vista" etiqueta="Secciones de la página" opciones={[{ valor: "datos", texto: "Datos" }, { valor: "metodologia", texto: "Metodología" }]} />
  </div>

  <!-- Panel: Datos -->
  <div id="vista-datos" data-lp-panel="vista" class="datos-panel">
  <div class="text-left max-w-screen-xl mx-auto px-4 sm:px-8 lg:px-12 pb-12 mt-8 space-y-10">

    <!-- ── Resumen de presencia y actividad ──────────────────────────────── -->
    <Panel titulo="Resumen de presencia y actividad" subtitulo={`Datos globales de las ${totales.total} entidades analizadas en el estudio.`}>

      <!-- Métricas del universo -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mb-8">
        <StatCard titulo="Entidades monitorizadas" valor={`${totales.total}`} desglose={[{ valor: `en ${CATEGORIES.length} sectores del Estado y CCAA` }]} />
        <StatCard anillo={{ pct: 100 - pctSinNinguna }} titulo="Con presencia en alguna red" valor={`${totalesBase}`} unidad={`(${pctNum(totalesBase, totales.total)}%)`} desglose={[{ valor: `base de cálculo de los porcentajes de adopción` }]} />
        <StatCard anillo={{ pct: pctSinNinguna, color: "var(--sd-rose-pink)" }} titulo="Sin cuentas en redes" valor={`${totales.sinNinguna}`} unidad={`(${pctSinNinguna}%)`} desglose={[{ valor: `sin perfiles detectados en ninguna plataforma` }]} />
      </div>

      <!-- Cuentas registradas vs Actividad Real -->
      <div class="mb-8">
        <div class="mb-4">
          <h3 class="text-xs font-semibold uppercase font-mono text-muted-foreground">Presencia registrada vs. actividad en los últimos 30 días</h3>
          <p class="text-xs text-muted-foreground mt-0.5">Tener cuenta oficial no equivale a publicar con regularidad.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- X / Twitter -->
          <div class="datos-plat-card datos-plat-card--x">
            <div class="datos-plat-header">
              <span class="datos-plat-badge datos-plat-badge--x">𝕏 / Twitter</span>
              <span class="datos-plat-nature">Red privativa</span>
            </div>
            <div class="datos-plat-kpi">
              <Donut sectores={[{ etiqueta: "", valor: pctEnX, color: "var(--sd-fg-2)" }]} maximo={100} tam={40} grosor={4} leyenda={false} decorativo />
              <div class="datos-plat-num">{totales.enX}</div>
              <div class="datos-plat-pct">{pctEnX}% activas</div>
            </div>
            <div class="datos-plat-bar-wrap">
              <Barra alto="md" tramos={[{ pct: pctEnX, color: "var(--sd-fg-2)", opacidad: 0.75 }, { pct: pctConTw - pctEnX, color: "var(--sd-fg-2)", opacidad: 0.2 }]} />
              <div class="datos-plat-bar-labels">
                <span>{pctEnX}% activas</span>
                <span>{pctConTw}% con cuenta ({totales.conTwitter})</span>
              </div>
            </div>
            <div class="datos-plat-stats">
              <div class="datos-plat-stat-row">
                <span>Con cuenta sin actividad reciente</span>
                <span class="font-mono text-muted-foreground">{totales.sinActX} ({pctSinActX}%)</span>
              </div>
              <div class="datos-plat-stat-row">
                <span>Tasa de actividad sobre sus cuentas</span>
                <span class="font-mono font-medium">{Math.round((totales.enX / totales.conTwitter) * 100)}%</span>
              </div>
            </div>
          </div>

