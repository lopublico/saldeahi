                { amb: "CCAA", forma: "Entidad Pública Empresarial", inv: 32, cub: 32 },
                { amb: "CCAA", forma: "Ente Público", inv: 121, cub: 121 },
                { amb: "CCAA", forma: "Fundación", inv: 219, cub: 0 },
                { amb: "CCAA", forma: "Sociedad Mercantil", inv: 214, cub: 0 },
                { amb: "CCAA", forma: "Consorcio", inv: 123, cub: 0 },
                { amb: "CCAA", forma: "Fondo sin personalidad jurídica", inv: 2, cub: 0 },
                { amb: "Universidades", forma: "Universidad pública", inv: 49, cub: 50 },
