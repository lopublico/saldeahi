</style>

<script>
  function initCatToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('#cat-toggle .datos-toggle-btn[data-cat]');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.cat!;
        buttons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        document.querySelectorAll<HTMLElement>('.cat-panel').forEach(panel => {
          panel.classList.toggle('cat-panel--hidden', panel.id !== `cat-panel-${target}`);
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initCatToggle);
  initCatToggle();

  function initParlToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('#parl-toggle .datos-toggle-btn[data-parl]');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.parl!;
        buttons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        document.querySelectorAll<HTMLElement>('.parl-panel').forEach(panel => {
          panel.classList.toggle('parl-panel--hidden', panel.id !== `parl-panel-${target}`);
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initParlToggle);
  initParlToggle();

  function initToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.datos-toggle-btn[data-show]');

    function activateTab(target: string, pushState = false) {
      buttons.forEach(b => b.classList.toggle('is-active', b.dataset.show === target));
      document.querySelectorAll<HTMLElement>('.datos-panel').forEach(panel => {
        panel.classList.toggle('datos-panel--hidden', panel.id !== `datos-panel-${target}`);
      });
      if (pushState) {
        history.replaceState(null, '', target === 'datos' ? location.pathname : `#${target}`);
      }
    }

    // Activar según hash inicial
    const initial = location.hash === '#metodologia' ? 'metodologia' : 'datos';
    activateTab(initial);

    buttons.forEach(btn => {
      btn.addEventListener('click', () => activateTab(btn.dataset.show!, true));
    });
  }
  document.addEventListener('astro:page-load', initToggle);
  initToggle();

  function initBarWidths() {
    document.querySelectorAll<HTMLElement>('[data-pct]').forEach(el => {
      el.style.width = el.dataset.pct + '%';
    });
    document.querySelectorAll<HTMLElement>('[data-left]').forEach(el => {
      el.style.left = el.dataset.left + '%';
    });
  }
  document.addEventListener('astro:page-load', initBarWidths);
  initBarWidths();

  function initSortableTables() {
    document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach(table => {
      const thead = table.querySelector('thead');
      const tbody = table.querySelector('tbody');
      if (!tbody) return;

      const allThs = thead?.querySelectorAll<HTMLElement>('th[data-sort]') ?? [];

      allThs.forEach(th => {
        th.addEventListener('click', () => {
          const col = th.dataset.sort!;
          const current = th.dataset.dir || '';
          const dir = current === 'asc' ? 'desc' : 'asc';

          allThs.forEach(h => {
            h.dataset.dir = '';
            const ind = h.querySelector('.datos-sort-ind');
            if (ind) ind.textContent = '';
          });
          th.dataset.dir = dir;
          const ind = th.querySelector('.datos-sort-ind');
          if (ind) ind.textContent = dir === 'asc' ? ' ↑' : ' ↓';

          const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr:not([data-footer])'));
          const footer = tbody.querySelector<HTMLTableRowElement>('tr[data-footer]');

          rows.sort((a, b) => {
            const aCell = a.querySelector<HTMLElement>(`td[data-col="${col}"]`);
            const bCell = b.querySelector<HTMLElement>(`td[data-col="${col}"]`);
            const aHasVal = aCell?.hasAttribute('data-val') ?? false;
            const bHasVal = bCell?.hasAttribute('data-val') ?? false;
            const av = aHasVal ? Number(aCell!.dataset.val) : (aCell?.textContent?.trim() ?? '');
            const bv = bHasVal ? Number(bCell!.dataset.val) : (bCell?.textContent?.trim() ?? '');
            if (av < bv) return dir === 'asc' ? -1 : 1;
            if (av > bv) return dir === 'asc' ? 1 : -1;
            return 0;
          });

          rows.forEach(r => tbody.appendChild(r));
          if (footer) tbody.appendChild(footer);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initSortableTables);

  // ── Tooltip para barras de adopción ──────────────────────────────────────────
  const TIP_STYLE = [
    'position:fixed', 'z-index:9999', 'background:#111', 'color:#fff',
    'padding:4px 10px', 'border-radius:6px', 'font-size:11px',
    'line-height:1.5', 'white-space:nowrap', 'pointer-events:none',
    'opacity:0', 'transition:opacity 0.12s',
    'box-shadow:0 2px 8px rgba(0,0,0,0.2)',
  ].join(';');

  function getTip() {
    let t = document.getElementById('bar-tip');
    if (!t) {
      t = document.createElement('div');
      t.id = 'bar-tip';
      t.setAttribute('style', TIP_STYLE);
      document.body.appendChild(t);
    }
    return t;
  }

  function findTipEl(target) {
    let el = target;
    while (el && el !== document.body) {
      if (el.dataset && el.dataset.tip) return el;
      el = el.parentElement;
    }
    return null;
  }

  if (!window._barTipListeners) {
    window._barTipListeners = true;

    document.addEventListener('mouseover', function (e) {
      const el = findTipEl(e.target);
      if (!el) { getTip().style.opacity = '0'; return; }
      const tip = getTip();
      tip.textContent = el.dataset.tip;
      const r = el.getBoundingClientRect();
      tip.style.left = (r.left + r.width / 2) + 'px';
      if (r.top > 60) {
        tip.style.top = (r.top - 8) + 'px';
        tip.style.transform = 'translate(-50%,-100%)';
      } else {
        tip.style.top = (r.bottom + 6) + 'px';
        tip.style.transform = 'translate(-50%,0)';
      }
      tip.style.opacity = '1';
    });

    document.addEventListener('mouseout', function (e) {
      const el = findTipEl(e.target);
      if (el && !el.contains(e.relatedTarget)) getTip().style.opacity = '0';
    });
  }

  document.addEventListener('astro:page-load', getTip);
  getTip();
</script>
