            </div>
            <div class="datos-plat-bar-wrap">
              <Barra alto="md" tramos={[{ pct: pctActBskyOfTotal, color: "var(--sd-sky)" }, { pct: pctBsky - pctActBskyOfTotal, color: "var(--sd-sky-soft)" }]} />
