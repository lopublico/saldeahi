---
import Layout from "../layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { AppSection } from "@/components/AppSection";

import ageData from "@/data/age.json";
import organosData from "@/data/organos.json";
import gobiernoData from "@/data/gobierno.json";
import congresoData from "@/data/congreso.json";
import senadoData from "@/data/senado.json";
import partidosData from "@/data/partidos.json";
import autonomiasData from "@/data/autonomias.json";
import universidadesData from "@/data/universidades.json";
import lastUpdateData from "@/data/lastUpdate.json";

const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
function platformRef(d: string | undefined) {
  return d ? new Date(d + "T00:00:00Z").getTime() : Date.now();
}
const lastUpdate = lastUpdateData as any;
const TWITTER_REF  = platformRef(lastUpdate.twitter);
const BLUESKY_REF  = platformRef(lastUpdate.bluesky);
const MASTODON_REF = platformRef(lastUpdate.mastodon);

function isActiveDate(val: unknown, ref: number): boolean {
  if (!val || typeof val !== "string") return false;
  if (!/^\d{4}-\d{2}-\d{2}/.test(val)) return false;
  return ref - new Date(val).getTime() <= THIRTY_DAYS_MS;
}
function twitterOnX(handle: unknown, activo: unknown): boolean {
  if (!handle) return false;
  if (activo == null) return true;
  return isActiveDate(activo, TWITTER_REF);
}
function normalizeItem(item: any) {
  return {
    twitter:         item.twitter  || null,
    twitter_activo:  twitterOnX(item.twitter, item.twitter_activo),
    bluesky_activo:  isActiveDate(item.bluesky_activo, BLUESKY_REF),
    bluesky_eurosky: !!item.bluesky_eurosky,
    mastodon_activo: isActiveDate(item.mastodon_activo, MASTODON_REF),
    mastodon:        item.mastodon || null,
    bluesky:         item.bluesky  || null,
  };
}

// Datos completos para el índice interactivo y las estadísticas unificadas
const allData = [
  ...ageData.map(normalizeItem),
  ...organosData.map(normalizeItem),
  ...gobiernoData.map(normalizeItem),
  ...congresoData.map(normalizeItem),
  ...senadoData.map(normalizeItem),
  ...partidosData.map(normalizeItem),
  ...autonomiasData.map(normalizeItem),
  ...universidadesData.map(normalizeItem),
];

const total = allData.length;
let enX = 0, conBluesky = 0, conMastodon = 0,
    conAlternativa = 0, sinAlternativa = 0, sinNinguna = 0;
for (const item of allData) {
  if (item.twitter_activo) enX++;
  if (item.bluesky)  conBluesky++;
  if (item.mastodon) conMastodon++;
  if (item.bluesky || item.mastodon) conAlternativa++;
  else if (item.twitter) sinAlternativa++;
  if (!item.twitter && !item.bluesky && !item.mastodon) sinNinguna++;
}
const fueraDeX = total - enX;
// Base de las estadísticas de elección de plataforma: se excluyen las entidades
// sin presencia en ninguna red (no participaron en la "elección" entre X/Bluesky/Mastodon).
// Siguen apareciendo en el índice, solo quedan fuera de estos porcentajes.
const base = total - sinNinguna;

const pctX   = base > 0 ? Math.round((enX            / base) * 100) : 0;
const pctB   = base > 0 ? Math.round((conBluesky     / base) * 100) : 0;
const pctM   = base > 0 ? Math.round((conMastodon    / base) * 100) : 0;
const pctSin = base > 0 ? Math.round((sinAlternativa / base) * 100) : 0;
const pctSinNinguna = total > 0 ? Math.round((sinNinguna / total) * 100) : 0;

// Donut math para stat-band
const DONUT_R = 15, DONUT_C = 2 * Math.PI * DONUT_R;
const donutDash = (pct: number) => `${(Math.max(0, Math.min(100, pct)) / 100) * DONUT_C} ${DONUT_C}`;

const updatedDate = lastUpdate.twitter
  ? new Date(lastUpdate.twitter + "T00:00:00Z").toLocaleDateString("es-ES", {
      day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
    })
  : "";
---

<Layout title="Sal de ahí - Lo Público" description="Los gobiernos democráticos siguen habitando espacios gobernados por oligarcas.">

  <!-- ── HERO OSCURO ──────────────────────────────────────────────── -->
  <div class="sd-hero">
    <Topbar dark active="índice" />

    <div class="sd-hero-inner max-w-screen-xl mx-auto px-4 sm:px-8 lg:px-12 pt-12 pb-10 sm:pt-14 sm:pb-12">

      <!-- Headline -->
      <h1 class="sd-hero-h1 text-4xl sm:text-6xl lg:text-[76px]">
        <span class="sd-hero-h1-num">{enX}</span>
        {" "}de{" "}
        <span class="sd-hero-h1-denom">{base}</span>
        <br class="max-sm:hidden" />
        {" "}instituciones y representantes
        <br />
        <span class="sd-hero-h1-serif">
siguen publicando en 
  <img src="/xlogo.png" alt="X" class="sd-hero-x-logo">
  .
</span>
      </h1>

      <!-- Manifesto + dark stats -->
      <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-8 md:gap-12 mt-12 md:mt-14 items-start">
        <p class="sd-hero-manifesto max-md:text-base">
          Los gobiernos democráticos habitan espacios gobernados por oligarcas.
        </p>

        <!-- Stats laterales oscuras -->
        <div class="sd-dark-stats">
          {[
            { label: "Con cuenta en Bluesky",       value: `${conBluesky} · ${pctB} %`,                    accentMod: "sky"     },
            { label: "Con cuenta en Mastodon",       value: `${conMastodon} · ${pctM === 0 ? '< 1' : pctM} %`, accentMod: "mastodon" },
            { label: "Sin alternativa a X",          value: `${sinAlternativa} · ${pctSin} %`,              accentMod: "rose", strong: true },
            { label: "Sin presencia en ninguna red", value: `${sinNinguna} · ${pctSinNinguna} %`,           accentMod: "outline" },
          ].map(({ label, value, accentMod, strong }) => (
            <div class="sd-dark-stat-row">
              <span class={`sd-dark-stat-label ${strong ? "sd-dark-stat-label--strong" : ""}`}>
                <span class={`sd-dark-stat-accent sd-dark-stat-accent--${accentMod}`}></span>
                {label}
              </span>
              <span class="sd-dark-stat-value">{value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Última actualización -->
      <div class="sd-hero-date">
        <div class="sd-hero-date-line">
          <span class="sd-hero-date-title">Última actualización: {updatedDate}</span>
          <span class="sd-hero-date-sep">·</span>
          <a href="https://zenodo.org/records/20692749" target="_blank" rel="noopener" class="sd-hero-date-link">
            Descarga de datos ↗
          </a>
          <span class="sd-hero-date-sep">·</span>
          <a href="/datos#metodologia" class="sd-hero-date-link">Metodología y criterios ↗</a>
        </div>
        <p class="sd-hero-date-desc">
          Monitorización de {total} instituciones públicas del Estado, autonomías, partidos y representantes. Actividad registrada en los últimos 30 días.
        </p>
      </div>
    </div>
  </div>

  <!-- ── BANDA DE ESTADÍSTICAS ────────────────────────────────────── -->
  <div class="sd-stat-band max-w-screen-xl mx-auto px-4 sm:px-8 lg:px-12">
    <div class="sd-sband-grid grid grid-cols-2 md:grid-cols-4 py-9 gap-8 md:gap-0">
      <!-- Divisores verticales (desktop) -->
      <div class="hidden md:block sd-sband-divider sd-sband-divider-q1"></div>
      <div class="hidden md:block sd-sband-divider sd-sband-divider-half"></div>
      <div class="hidden md:block sd-sband-divider sd-sband-divider-q3"></div>

      <!-- Col 1: X -->
      <div class="sd-sband-col md:px-4 lg:px-6">
        <div class="sd-sband-label">Con cuenta en X</div>
        <div class="sd-sband-num-row">
          <svg class="sd-sband-donut" width="42" height="42" viewBox="0 0 42 42">
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-line)" stroke-width="3.5"/>
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-fg-2)" stroke-width="3.5"
              stroke-dasharray={donutDash(pctX)}
              class="sd-sband-donut-x"
              transform="rotate(-90 21 21)"
            />
          </svg>
          <span class="sd-sband-num">{pctX}&#x202F;%</span>
        </div>
        <div class="sd-sband-sub">{enX} de {base} entidades</div>
      </div>

      <!-- Col 2: Bluesky -->
      <div class="sd-sband-col md:px-4 lg:px-6">
        <div class="sd-sband-label">Con cuenta en Bluesky</div>
        <div class="sd-sband-num-row">
          <svg class="sd-sband-donut" width="42" height="42" viewBox="0 0 42 42">
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-line)" stroke-width="3.5"/>
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-sky)" stroke-width="3.5"
              stroke-dasharray={donutDash(pctB)}
              transform="rotate(-90 21 21)"
            />
          </svg>
          <span class="sd-sband-num">{pctB}&#x202F;%</span>
        </div>
        <div class="sd-sband-sub">{conBluesky} entidades</div>
      </div>

      <!-- Col 3: Mastodon -->
      <div class="sd-sband-col md:px-4 lg:px-6">
        <div class="sd-sband-label">Con cuenta en Mastodon</div>
        <div class="sd-sband-num-row">
          <svg class="sd-sband-donut" width="42" height="42" viewBox="0 0 42 42">
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-line)" stroke-width="3.5"/>
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-mastodon)" stroke-width="3.5"
              stroke-dasharray={donutDash(pctM === 0 && conMastodon > 0 ? 1 : pctM)}
              transform="rotate(-90 21 21)"
            />
          </svg>
          <span class="sd-sband-num">
            {pctM === 0 ? '< 1' : pctM}&#x202F;%
          </span>
        </div>
        <div class="sd-sband-sub">{conMastodon} entidades</div>
      </div>

      <!-- Col 4: Sin alternativa -->
      <div class="sd-sband-col md:px-4 lg:px-6">
        <div class="sd-sband-label">Sin alternativa a X</div>
        <div class="sd-sband-num-row">
          <svg class="sd-sband-donut" width="42" height="42" viewBox="0 0 42 42">
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-line)" stroke-width="3.5"/>
            <circle cx="21" cy="21" r={DONUT_R} fill="none" stroke="var(--sd-rose-pink)" stroke-width="3.5"
              stroke-dasharray={donutDash(pctSin)}
              transform="rotate(-90 21 21)"
            />
          </svg>
          <span class="sd-sband-num">{pctSin}&#x202F;%</span>
        </div>
        <div class="sd-sband-sub sd-sband-sub--em">
          {sinAlternativa} entidades
        </div>
      </div>
    </div>
  </div>

  <!-- ── ÍNDICE (tabla interactiva) ──────────────────────────────── -->
  <div class="sd-index max-w-screen-xl mx-auto pb-16 pt-4">
    <AppSection
      client:load
      initialStats={{
        enX,
        fueraDeX,
        conBluesky,
        conMastodon,
        conAlternativa,
        sinAlternativa,
        sinNinguna,
      }}
    />
  </div>

</Layout>

<style is:global>
/* ═══════════════════════════════════════════════════════════════════
   index.astro – Hero & stat-band styles
   All sd-hero-* and sd-sband-* classes are defined here.
═══════════════════════════════════════════════════════════════════ */

/* ── Hero ──────────────────────────────────────────────────────── */

.sd-hero {
  position: relative;
  overflow: hidden;
  color: #f6f4ef;
  padding-bottom: 4px;
}

/* imagen con blur */
.sd-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-color: black;
  /*
  background: url('/public/delicias.jpg') center 50% / cover no-repeat; */
  filter: blur(4px);
  transform: scale(1.06);
  z-index: 0;
  animation: heroKenBurns 28s ease-in-out infinite alternate;
  will-change: transform;
}

@keyframes heroKenBurns {
  0%   { transform: scale(1.08) translate(0,     0);      }
  25%  { transform: scale(1.16) translate(-2.5%, 1.8%);   }
  50%  { transform: scale(1.12) translate(2%,   -1.5%);   }
  75%  { transform: scale(1.18) translate(-1.5%, 2.5%);   }
  100% { transform: scale(1.13) translate(2.5%, -1%);     }
}

/* capa oscura (casi negro) */
.sd-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 1;
}

/* contenido por encima */
.sd-hero > * {
  position: relative;
  z-index: 2;
}


.sd-hero-h1 {
  font-family: var(--font-sans);
  font-weight: 600;
  line-height: 1.04;
  letter-spacing: -0.035em;
  color: #fff;
  margin: 0;
  max-width: 1040px;
}

.sd-hero-h1-num {
  font-family: var(--font-mono);
  font-weight: 500;
  letter-spacing: -0.03em;
  font-variant-numeric: tabular-nums;
}

.sd-hero-h1-denom {
  font-family: var(--font-mono);
  font-weight: 500;
  letter-spacing: -0.03em;
  color: rgba(255,255,255,0.45);
  font-variant-numeric: tabular-nums;
}

.sd-hero-h1-serif {
  font-family: 'Lora', Georgia, serif;
  font-style: italic;
  font-weight: 500;
}

.sd-hero-x-logo {
  height: .9em;
  width: auto;
  vertical-align: -0.1em;
  display: inline-block;
}

.sd-hero-manifesto {
  font-family: 'Lora', Georgia, serif;
  font-style: italic;
  font-size: 18px;
  line-height: 1.55;
  color: rgba(246,244,239,0.85);
  margin: 0;
}

/* ── Dark stat sidebar (Editorial HUD panel inspired by SatMap in blog) ── */
.sd-dark-stats {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1;
  color: rgba(246,244,239,0.75);
  letter-spacing: 0.02em;
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 6px;
  padding: 12px 18px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.sd-dark-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  padding: 9px 0;
  gap: 16px;
}
.sd-dark-stat-row:first-child {
  padding-top: 2px;
}
.sd-dark-stat-row:last-child {
  border-bottom: none;
  padding-bottom: 2px;
}

.sd-dark-stat-label {
  display: flex;
  align-items: center;
  gap: 9px;
  color: rgba(246,244,239,0.7);
  font-size: 12px;
}

.sd-dark-stat-label--strong {
  color: #fff;
}

.sd-dark-stat-accent {
  width: 7px;
  height: 7px;
  display: inline-block;
  flex-shrink: 0;
  border-radius: 50%;
}

.sd-dark-stat-accent--outline  { background: transparent; border: 1.5px solid rgba(246,244,239,0.45); }
.sd-dark-stat-accent--sky      { background: var(--sd-sky); }
.sd-dark-stat-accent--mastodon { background: var(--sd-mastodon); }
.sd-dark-stat-accent--rose     { background: var(--sd-rose-pink); }

.sd-dark-stat-value {
  color: #fff;
  font-weight: 500;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* ── Hero date footer ──────────────────────────────────────────── */
.sd-hero-date {
  margin-top: 22px;
  padding-top: 14px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.sd-hero-date-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
}

.sd-hero-date-title {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(246,244,239,0.55);
  margin: 0;
}

.sd-hero-date-sep {
  color: rgba(246,244,239,0.3);
  font-size: 11px;
}

.sd-hero-date-link {
  font-family: var(--font-mono);
  font-size: 11px;
  color: rgba(246,244,239,0.7);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.14s ease;
}
.sd-hero-date-link:hover {
  color: #fff;
}

.sd-hero-date-desc {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: rgba(246,244,239,0.45);
  margin: 4px 0 0;
  letter-spacing: 0.01em;
  line-height: 1.5;
}

/* ── Stat-band ─────────────────────────────────────────────────── */
.sd-stat-band {
  border-top: 1px solid var(--sd-line);
  border-bottom: 1px solid var(--sd-line);
  background: var(--background);
}

.sd-sband-grid {
  position: relative;
}

.sd-sband-divider {
  position: absolute;
  top: 24px;
  bottom: 24px;
  width: 1px;
  background: var(--sd-line);
}

.sd-sband-divider-q1   { left: 25%; }
.sd-sband-divider-half { left: 50%; }
.sd-sband-divider-q3   { left: 75%; }

.sd-sband-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.sd-sband-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  color: var(--sd-muted);
  text-transform: uppercase;
  font-weight: 500;
  margin-bottom: 10px;
  text-align: center;
}

.sd-sband-num-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 8px;
}

.sd-sband-donut {
  flex-shrink: 0;
  display: block;
}

.sd-sband-num {
  font-family: var(--font-sans);
  font-weight: 600;
  font-size: 38px;
  letter-spacing: -0.025em;
  line-height: 1;
  color: var(--sd-fg-2);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

.sd-sband-sub {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--sd-muted);
  letter-spacing: 0.01em;
}

.sd-sband-sub--em {
  color: var(--sd-rose-pink);
  font-weight: 500;
}
</style>
