---
import Pagina404 from "@lopublico/ui/Pagina404.astro";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
---

<Layout
  title="404 — Sal de ahí"
  description="Página no encontrada. Esta página ha decidido salir de ahí."
  active=""
>
  <Pagina404
    tono="oscuro"
    texto="El enlace que has seguido no existe, ha cambiado de dirección o simplemente ya no está disponible."
    acciones={[
      { href: "/", texto: "← Volver al índice" },
      { href: "/datos", texto: "Consultar los datos" },
      { href: "/porque", texto: "¿Por qué importa?" },
    ]}
  >
    <Topbar slot="cabecera" dark active="" />
    <Fragment slot="titulo">Esta página ha decidido <span class="sd-404-serif">salir de ahí.</span></Fragment>
  </Pagina404>
</Layout>

<style>
  .sd-404-serif { font-family: 'Lora', Georgia, serif; font-style: italic; font-weight: 500; color: #f6f4ef; }
  :global(.lp-404-texto) { font-family: 'Lora', Georgia, serif; font-style: italic; }
</style>
