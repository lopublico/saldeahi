---
// Cabecera de Sal de ahí: envoltorio fino sobre el SiteHeader compartido (@lopublico/ui).
// `dark` la deja transparente sobre el hero oscuro; `active` marca el enlace actual.
import SiteHeader from "@lopublico/ui/SiteHeader.astro";
interface Props {
  dark?: boolean;
  active?: string;
}
const { dark = false, active = "índice" } = Astro.props;
---

<SiteHeader
  nombre="Sal de ahí"
  logo="/logos/saldeahi.png"
  tono={dark ? "oscuro" : "claro"}
  enlaces={[
    { href: "/", texto: "Índice", activo: active === "índice" },
    { href: "/datos", texto: "Datos", activo: active === "datos" },
    { href: "/porque", texto: "Por qué", activo: active === "por qué" },
    { href: "https://lopublico.es", texto: "LoPúblico", externo: true, imagen: "/logos/lopublico.png" },
  ]}
/>
